{
  "builds": [
    { "src": "main.py", "use": "@vercel/python" },
    { "src": "static/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/static/$1" },
    { "src": "/(.*)", "dest": "/main.py" }
  ],
  "crons": [
    {
      "path": "/api/cron/check-funds",
      "schedule": "0 */6 * * *"
    }
  ]
}
